{
  "name": "lantern",
  "version": "1.0.0",
  "description": "Lantern — a markdown novel-writing app on Cloudflare",
  "scripts": {
    "dev": "vite",
    "dev:api": "mkdir -p dist && wrangler dev",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply lantern-db --local",
    "db:migrate": "wrangler d1 migrations apply lantern-db --remote",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brendonking32/lantern.git"
  }
}
